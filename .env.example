# ==========================================
# Fitnex Backend Environment Variables
# ==========================================

# Application Environment
NODE_ENV=development
PORT=5000
API_PREFIX=api/v1
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# MongoDB Connection
# Default local instance or MongoDB Atlas URI
MONGODB_URI=mongodb://localhost:27017/fitnex

# JWT Authentication
JWT_SECRET=fitnex_super_secret_jwt_access_key_2026
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=fitnex_super_secret_jwt_refresh_key_2026
JWT_REFRESH_EXPIRATION=7d

# Nodemailer with Mailtrap Configuration
# Sign up at https://mailtrap.io to get sandbox SMTP credentials
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_mailtrap_username
MAIL_PASS=your_mailtrap_password
MAIL_FROM="Fitnex Team" <no-reply@fitnex.com>
